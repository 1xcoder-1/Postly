# ── Database (Neon free Postgres) — optional ──────────────────
# Project Settings -> API & SQL -> Connection string. Leave blank to use the
# local JSON fallback store (data/posts.json). Rows are scoped to a
# per-device id, so no login/account is ever required.
DATABASE_URL=

# ── Gemini (the app's ONLY AI key) ────────────────────────────
# Used for one feature only: the "image brief" on a topic — text advice about
# what visual to make + copy-ready prompts. Nothing is auto-generated or posted.
# Get a free key at aistudio.google.com (starts with AIza).
GEMINI_API_KEY=

# ── Crawlers ──────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Scout:v0.1 (by /u/yourusername)
# Python binary used by backend/services/crawlerService.ts (default: python)
PYTHON_BIN=

# Keep ONLY English topics (drops Arabic/Urdu/Hindi/CJK/etc.). Default on; set 0 to disable.
ENGLISH_ONLY=1
# Drop beginner/tutorial-style titles ("Python tutorial / day 1 / build a web app /
# crash course"). Default on; set 0 to disable. You want industry news, not how-tos.
FILTER_TUTORIALS=1
# Tech-only policy for EVERY crawler: keep software/dev/tech-industry topics and drop
# off-topic items (biology & medicine, machinery, earth/atmosphere & climate, space
# science, sports, war/crime, showbiz, Wordle hints, Prime Day deal spam). Default on;
# set 0 to see everything the crawlers return.
TECH_ONLY=1

# Hacker News volume (official Algolia API, no key needed). Tune how MANY recent
# stories are pulled so the Dashboard/TopicRadar can show 50-100+ topics.
HN_HITS=120         # stories per fetch (max 1000)
HN_DAYS=3           # look back this many days
HN_MIN_POINTS=10    # ignore stories below this many points

# dev.to RSS (replaced the retired daily.dev API; free, no key). Volume knobs:
DEVTO_MAX=120       # total items collected across feeds
# DEVTO_TAGS=ai,programming,webdev,javascript,typescript,rust,devops,machinelearning,startup,security,go,react
DEVTO_TAGS=

# Bluesky via the public AT Protocol API (no key, no account). Always attempted,
# dormant-safe. Anonymous access reads AUTHOR FEEDS only (searchPosts now 403s
# without a session), so volume comes from the wide verified seed in
# references.json -> bsky.authors. Extend it here:
#   BLUESKY_AUTHORS="vercel.com,github.com"
BLUESKY_AUTHORS=
# Depth per author (defaults shown): BSKY_PER_AUTHOR=30 BSKY_MIN_LIKES=2

# YouTube depth (yt-dlp). Higher = more topics but slower; keep YT_BUDGET_SECONDS
# under the crawler timeout. Defaults: YT_PER_CHANNEL=6 YT_BUDGET_SECONDS=75
# Leave blank to use the defaults (an empty value is ignored, not an error).
YT_PER_CHANNEL=
YT_BUDGET_SECONDS=

# Reference-driven sources. backend/crawlers/references.json is the seed list
# (YouTube videos/channels, Instagram profiles/posts, LinkedIn links) built from
# your reference.md. Override or extend per-source here — content is ALWAYS
# scraped live; these only say WHERE to look.
# YouTube via yt-dlp (pip install yt-dlp). Comma list of video URLs/IDs, @handles,
# channel URLs, or plain channel names. Leave blank to use references.json.
YT_REFS=
YT_CHANNELS=
# LinkedIn / any tech link via the agent-reach web (Jina Reader) channel. Comma
# list of public URLs; merged with references.json -> linkedin.posts.
LINKEDIN_REFS=
# Instagram (best-effort; anonymous reads are rate-limited). Enable ONE of:
#   IG_PROFILES=github,stripe,openai     (live public profiles; needs pip install instaloader)
#   IG_USER / IG_PASSWORD=...            (login to escape the anonymous rate-limit wall)
#   IG_EXPORT_FILES=C:/dl/posts_a.json,C:/dl/posts_b.json   (ingest an export you already have)
IG_PROFILES=
IG_EXPORT_FILES=
IG_USER=
IG_PASSWORD=

# Custom sources / optional crawlers (all OPT-IN; leave blank to disable)
# Extra subreddits merged with the defaults above.
REDDIT_SUBREDDITS=
# Crawl4AI general web / news / daily.dev deep scraping (needs `pip install crawl4ai` + `crawl4ai-setup`)
CRAWL4AI_URLS=
# X / Twitter via twscrape (needs `pip install twscrape`, then `twscrape add_accounts`
# or `twscrape add_cookie <auth_token>` to configure YOUR X account).
# Always attempted, but stays dormant (prints []) until twscrape has an account.
# Seed list of famous accounts/queries lives in references.json -> x; extend here:
#   X_ACCOUNTS="karpathy,OpenAI,Vercel"   (latest posts from these handles)
#   X_QUERIES="AI agents, developer tools" (search terms)
X_ACCOUNTS=
X_QUERIES=

# Threads (Meta) via keyless crawl: famous profiles from references.json ->
# threads.users are sampled each refresh (THREADS_SAMPLE), topped up by 21
# verified tech-creator feeds so the tab always clears 90+.
THREADS_SAMPLE=24

# Facebook via keyless crawl: the famous pages' own verified newsroom RSS
# feeds carry the tab. references.json -> facebook.pages also seeds 2000+
# pages for the real-data paths below (sampled FACEBOOK_SAMPLE pages/refresh):
#   FB_ACCESS_TOKEN = Page/User token from developers.facebook.com -> official
#     Graph API /{page}/posts (message + permalink) for the seeded pages.
#   FB_RSS_BRIDGE   = URL of a self-hosted RSS-Bridge instance -> FacebookBridge
#     page feeds. Leave both blank to stay on the keyless newsroom path.
FB_ACCESS_TOKEN=
FB_RSS_BRIDGE=
FACEBOOK_SAMPLE=24

# ── Account-login crawling (personalized feeds) ───────────────
# Optional: connect YOUR OWN account so the crawlers can read a logged-in feed.
# Paste the values below straight into .env (there is no in-app account UI any
# more — the app never posts anywhere, it only reads public sources for topics).
#
# Where to get each value manually (browser DevTools → Application → Cookies):
#   • X_AUTH_TOKEN : x.com  → cookie named `auth_token`
#   • X_CT0        : x.com  → cookie named `ct0` (X needs BOTH to verify)
#   • LINKEDIN_LI_AT: linkedin.com → cookie named `li_at`
#   • REDDIT_COOKIE : reddit.com → cookie named `token_v2` (a JWT)
# A full cookie-jar paste is tolerated — Scout extracts the named cookie for
# you (e.g. pasting "auth_token=…; ct0=…" into X_AUTH_TOKEN works). Blank = off;
# leaving these empty keeps the anonymous/budget crawl behaviour unchanged.
# WARNING: automated access may violate platform terms — use at your own risk,
# at low volume. Never commit real values.
X_AUTH_TOKEN=
X_CT0=
LINKEDIN_LI_AT=
REDDIT_COOKIE=

# Breadth controls for the logged-in crawlers (how wide each personal feed goes).
# MIN_SOURCES        minimum distinct sources before a crawl is considered full (default 100)
# X_MAX_ACCOUNTS     max X accounts/queries to pull per crawl (default 60)
# REDDIT_MAX_SUBS    max subreddits to pull per crawl (default 60)
# LINKEDIN_FEED_COUNT LinkedIn feed items to pull per crawl (default 25)
MIN_SOURCES=100
X_MAX_ACCOUNTS=60
REDDIT_MAX_SUBS=60
LINKEDIN_FEED_COUNT=25

# Crawler behaviour
# Cache combined topics for this many minutes so the Dashboard doesn't re-crawl
# on every refresh (default 45; spec asks for 30-60).
CRAWLER_CACHE_MINUTES=45
# Drop topics whose engagement score is below this (0 disables the filter).
CRAWLER_MIN_ENGAGEMENT=0
